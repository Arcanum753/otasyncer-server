{
    "host": "0.0.0.0",
    "port": 8080,
    "firmware_dirs": [
        {
            "path": "./firmware",
            "delete_old_versions": true
        },
        {
            "path": "D:\\github\\avr-fota\\proj_fwbins",
            "delete_old_versions": true
        }
    ],
    "manifest_path": "/manifest.json",
    "device_username": "",
    "device_password": "",
    "device_http_port": 80,
    "backup": {
        "dir": "./backups",
        "timeout_s": 10,
        "upload_timeout_s": 30,
        "inter_request_delay_ms": 150,
        "max_file_bytes": 1048576,
        "keep_manual": 10,
        "restore_verify": "size",
        "include_patterns": ["/config_*.json", "/secret.json", "/macros/*.lua", "/avrisp.json"],
        "exclude_patterns": ["/_version_fs.json", "/*_cfg.json"],
        "extra_config_files": []
    },
    "fs_update": {
        "keep_snapshots": 5,
        "reconnect_timeout_s": 300,
        "status_poll_s": 3,
        "restart_after_restore": true
    },
    "udp_listener": {
        "is_listening": true,
        "receive_port": 40000,
        "transmit_port": 40001,
        "keyword": "Ave_Omnissiah",
        "device_timeout_minutes": 10,
        "device_cleanup_hours": 24,
        "probe_devices_on_startup": true
    },
    "traffic_light": {
        "is_minutes_mode": true,
        "green_time": 1,
        "yellow_time": 2,
        "red_time": 3
    },
    "logging": {
        "enabled": true,
        "directory": "log"
    }
}